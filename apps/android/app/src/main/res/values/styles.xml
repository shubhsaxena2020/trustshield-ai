<resources>
    <style name="Theme.TrustShield" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- A brand mark, not the launcher foreground: the launcher foreground fills the shield
             white, which is invisible on this splash background (about 1.05:1) and left only a bare
             blue check on screen (#139). ic_splash_mark draws the blue shield-T instead. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.TrustShield.App</item>
    </style>

    <style name="Theme.TrustShield.App" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/trustshield_blue</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
