# TrustShield configuration reference. Copy to .env for local use; NEVER commit real values (no secret is needed for Milestone A).
# On Render/Vercel set these in the provider dashboard instead of a file.

# --- runtime profile -----------------------------------------------------------------------------------------------
# development | staging | production. staging and production run the SAME hardened profile and refuse to start on bad config.
TRUSTSHIELD_ENV=development
# Model: leave empty for the promoted default (trustshield_text_v3). trustshield_text_v1 is the rollback (development only).
TRUSTSHIELD_ML_MODEL=

# --- API (Render) --------------------------------------------------------------------------------------------------
# Comma-separated bare https origins of the deployed frontend, e.g. https://trustshield-xxxx.vercel.app (no wildcard, no localhost).
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_API_URL=
TESSERACT_CMD=
MAX_UPLOAD_SIZE=5242880
# Number of trusted reverse-proxy hops in front of the API (0 = use the socket address). Set after observing the platform's
# X-Forwarded-For chain in staging; wrong values weaken per-client rate limiting.
TRUSTSHIELD_TRUSTED_PROXY_HOPS=0
TRUSTSHIELD_RATE_LIGHT_PER_MIN=120
TRUSTSHIELD_RATE_HEAVY_PER_MIN=30
TRUSTSHIELD_HEAVY_CONCURRENCY=2
TRUSTSHIELD_REQUEST_TIMEOUT=45
# sandbox_only in staging/production (analyses are not retained); "all" only for local development.
TRUSTSHIELD_RESULT_STORE=all
TRUSTSHIELD_RESULT_TTL=900

# --- frontend (Vercel; NEXT_PUBLIC_* are baked in at BUILD time) ------------------------------------------------------
# Leave unset in production (same-origin /api on Vercel). Local development uses http://localhost:8000.
NEXT_PUBLIC_API_URL=

# --- security boundary: MUST stay false for Milestone A ------------------------------------------------------------------
ENABLE_WEB_SANDBOX=false
TRUSTSHIELD_SANDBOX_ALLOW_EXTERNAL=false
ENABLE_EXTERNAL_REPUTATION=false
WEB_SCAN_TIMEOUT=20

# --- reserved, not used in Milestone A (stateless; no database) -----------------------------------------------------------
DATABASE_URL=

# --- conversational AI provider (docs/PROVIDER_CONFIGURATION.md) -----------------------------------------------------------
# Leave TRUSTSHIELD_AI_PROVIDER unset for the deterministic provider (default; always grounded, no LLM). "ollama" is
# development-only and never selected in staging/production regardless of this value. "remote" needs BOTH
# TRUSTSHIELD_AI_BASE_URL and TRUSTSHIELD_AI_API_KEY set to activate -- NEVER commit a real key here.
TRUSTSHIELD_AI_PROVIDER=
TRUSTSHIELD_AI_MODEL=
TRUSTSHIELD_AI_BASE_URL=
TRUSTSHIELD_AI_API_KEY=
TRUSTSHIELD_OLLAMA_URL=

# --- versioned conversation-context signing (docs/CONVERSATIONAL_REVIEW.md) ------------------------------------------------
TRUSTSHIELD_CONTEXT_SECRET=
TRUSTSHIELD_CONTEXT_KEY_VERSION=
TRUSTSHIELD_CONTEXT_PREVIOUS_SECRET=
TRUSTSHIELD_CONTEXT_PREVIOUS_KEY_VERSION=
