# TrustShield configuration reference. Copy to .env for local use; NEVER commit real values.
# For the tech-expo booth setup (local backend + frontend + 9Router, Cloudflare Tunnel on the frontend only), see
# docs/EXPO_DEPLOYMENT_RUNBOOK.md -- this file lists every variable the app reads, not just that one setup's values.

# --- runtime profile -----------------------------------------------------------------------------------------------
# development | staging | production. staging and production run the SAME hardened profile and refuse to start on bad config.
TRUSTSHIELD_ENV=development
# Model: leave empty for the promoted default (trustshield_text_v3). trustshield_text_v1 is the rollback (development only,
# additionally needs TRUSTSHIELD_ROLLBACK_CONFIRM=v1 in staging/production).
TRUSTSHIELD_ML_MODEL=
TRUSTSHIELD_ROLLBACK_CONFIRM=
# "off" disables the ML classifier entirely (rules-only); not allowed in staging/production.
TRUSTSHIELD_ML=on
# Risk-fusion strategy; staging/production require the default.
TRUSTSHIELD_FUSION=ml_aware_weighted

# --- OCR -------------------------------------------------------------------------------------------------------------
# tesseract (default) | mock (demo/test only, refused in staging/production)
TRUSTSHIELD_OCR_PROVIDER=tesseract
TESSERACT_CMD=
TRUSTSHIELD_OCR_PREPROCESS=current
TRUSTSHIELD_OCR_TIMEOUT=30

# --- API ---------------------------------------------------------------------------------------------------------
# Comma-separated bare https origins of the deployed frontend (no wildcard, no localhost in staging/production).
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_API_URL=
MAX_UPLOAD_SIZE=5242880
# Number of trusted reverse-proxy hops in front of the API (0 = use the socket address). Set after observing the platform's
# X-Forwarded-For chain; wrong values weaken per-client rate limiting.
TRUSTSHIELD_TRUSTED_PROXY_HOPS=0
TRUSTSHIELD_RATE_LIGHT_PER_MIN=120
TRUSTSHIELD_RATE_HEAVY_PER_MIN=30
TRUSTSHIELD_HEAVY_CONCURRENCY=2
TRUSTSHIELD_HEAVY_QUEUE_TIMEOUT=8
TRUSTSHIELD_REQUEST_TIMEOUT=45
# "sandbox_only" in staging/production (minimal retention); "all" only for local development.
TRUSTSHIELD_RESULT_STORE=all
TRUSTSHIELD_RESULT_TTL=900
TRUSTSHIELD_RESULT_MAX=200
TRUSTSHIELD_DEBUG_PROXY=
ENABLE_EXTERNAL_REPUTATION=false

# --- frontend (NEXT_PUBLIC_* are baked in at BUILD time) ------------------------------------------------------
# Leave unset for same-origin /api; set to the API's own URL (e.g. http://localhost:8000) when frontend and backend
# are served separately, as in the local expo setup.
NEXT_PUBLIC_API_URL=

# --- accounts and history (optional: unset disables login/history, anonymous scanning is unaffected) ---------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- conversational AI provider (docs/PROVIDER_CONFIGURATION.md) -----------------------------------------------------------
# Leave TRUSTSHIELD_AI_PROVIDER unset for the deterministic provider (default; always grounded, no LLM). "ollama" is
# development-only and never selected in staging/production regardless of this value. "remote" needs BOTH
# TRUSTSHIELD_AI_BASE_URL and TRUSTSHIELD_AI_API_KEY set to activate -- NEVER commit a real key here.
TRUSTSHIELD_AI_PROVIDER=
TRUSTSHIELD_AI_MODEL=
TRUSTSHIELD_AI_BASE_URL=
TRUSTSHIELD_AI_API_KEY=
# Optional: set TRUSTSHIELD_AI_PRIMARY_MODEL (and, optionally, _SECONDARY_MODEL) to use a multi-tier ProviderChain
# instead of a single model, sharing the same TRUSTSHIELD_AI_BASE_URL/_API_KEY.
TRUSTSHIELD_AI_PRIMARY_MODEL=
TRUSTSHIELD_AI_SECONDARY_MODEL=
# Dev-only Ollama provider, independent of the TRUSTSHIELD_AI_* remote config above.
TRUSTSHIELD_OLLAMA_URL=
TRUSTSHIELD_OLLAMA_MODEL=

# --- conversation-context signing (services/chat/signing.py) -----------------------------------------------------------
# HMAC secret that signs analysis context so follow-ups cannot be forged. Set a long random value in every non-test environment.
TRUSTSHIELD_CONTEXT_SECRET=
