The write landed but I left some sloppy junk in it (a stray Cyrillic comment and dead code). Rewriting the file cleanly:

```python
#!/usr/bin/env python
"""Manual-QA harness for the TrustShield chat UI.

Not collected by pytest. Mirrors docs/MANUAL_QA_CHECKLIST.md sections A2, B3,
B4, C1-C3 and D1. Targets the loopback stack only: frontend on 127.0.0.1:3000,
backend on 127.0.0.1:8000. When either is down the script exits non-zero with a
report and NEVER starts servers itself (that is manual, per the checklist).

Usage:  .venv/Scripts/python.exe tests/e2e/run_manual_qa_playwright.py [--web URL] [--api URL]
"""
from __future__ import annotations

import argparse
import json
import sys
import urllib.request
from pathlib import Path

from playwright.sync_api import Page, sync_playwright

ROOT = Path(__file__).resolve().parents[2]
SHOTS = ROOT / "tests" / "e2e" / "screenshots"
KYC_REL_PATH = "kyc_screenshot.png"

results: list[tuple[str, bool]] = []


def check(name: str, ok: bool, detail: str = "") -> None:
    results.append((name, bool(ok)))
    print(("PASS " if ok else "FAIL ") + name + (f" — {detail}" if detail and not ok else ""))


def drop(page: Page, spec: dict) -> None:
    """Dispatch a real DataTransfer drop on the chat surface (the component's own handler)."""
    page.evaluate(
        """async (spec) => {
            const buffer = new Uint8Array(await (await fetch(spec.url)).arrayBuffer());
            const file = new File([buffer], spec.name, {type: spec.type});
            const dt = new DataTransfer();
            dt.items.add(file);
            const surface = document.querySelector('div.h-dvh') ?? document.body;
            for (const type of ['dragenter', 'dragover', 'drop']) {
                surface.dispatchEvent(new DragEvent(type, {dataTransfer: dt, bubbles: true, cancelable: true}));
                await new Promise((r) => setTimeout(r, 10));
            }
        }""",
        spec,
    )


def no_hscroll(page: Page) -> bool:
    return page.evaluate(
        "() => [document.documentElement, document.body].every((el) => el.scrollWidth <= el.clientWidth)"
    )


def run(page: Page, api_up: bool, timeout: int) -> None:
    body = lambda: page.inner_text("body")  # noqa: E731
    mic = page.locator("button[aria-label='Speak your message'], button[aria-label='Stop voice input']")
    preview = page.locator("img[alt='Attachment preview']")

    check("initial render", page.locator("textarea").count() == 1 and "Avoid sharing passwords, OTPs or card secrets" in body())

    # C1 — real PNG onto the chat surface -> preview appears above the message box.
    kyc = {"url": f"/{KYC_REL_PATH}", "name": KYC_REL_PATH, "type": "image/png"}
    drop(page, kyc)
    preview.wait_for(state="visible", timeout=10_000)
    check("C1 kyc_screenshot.png drop: attachment preview appears", preview.count() == 1)
    page.click("button[aria-label='Remove attachment']")
    drop(page, kyc)  # re-attach so the remove-button path and preview DOM are both covered
    check("C1 preview after drop then remove: state stays clean",
          preview.count() == 1 and page.locator("input[type=file]").count() == 1)
    page.click("button[aria-label='Remove attachment']")

    # C2 — 5 MB image is rejected with the size message.
    page.evaluate(
        """() => {
            const big = new Uint8Array(5 * 1024 * 1024);
            const file = new File([big], 'big.png', {type: 'image/png'});
            const dt = new DataTransfer();
            dt.items.add(file);
            const surface = document.querySelector('div.h-dvh') ?? document.body;
            surface.dispatchEvent(new DragEvent('dragover', {dataTransfer: dt, bubbles: true, cancelable: true}));
            surface.dispatchEvent(new DragEvent('drop', {dataTransfer: dt, bubbles: true, cancelable: true}));
        }"""
    )
    preview.wait_for(state="detached", timeout=5_000)
    check("C2 5 MB drop: rejected with the size message",
          "larger than 4 MB" in body() and page.locator("p[role='alert']").count() == 1 and preview.count() == 0,
          "no size warning or the big file was still attached")

    # C3 — .txt file: ignored (no preview, no crash, page still works).
    page.evaluate(
        """() => {
            const txt = new File(['hello world'], 'notes.txt', {type: 'text/plain'});
            const dt = new DataTransfer();
            dt.items.add(txt);
            const surface = document.querySelector('div.h-dvh') ?? document.body;
            for (const type of ['dragenter', 'dragover', 'drop']) {
                surface.dispatchEvent(new DragEvent(type, {dataTransfer: dt, bubbles: true, cancelable: true}));
            }
        }"""
    )
    check("C3 .txt drop: not accepted and the page still works",
          preview.count() == 0 and page.locator("p[role='alert']").count() == 0
          and "larger than 4 MB" not in body() and page.locator("textarea").is_editable())

    # B4/B3 — mic button exists with Web Speech; clicking it with permission denied shows a message.
    has_speech = page.evaluate("() => Boolean(window.SpeechRecognition ?? window.webkitSpeechRecognition)")
    if has_speech:
        check("B4 mic button exists because the browser has Web Speech", mic.count() == 1)
    else:
        check("B4 mic button hidden or disabled because the browser has no Web Speech", mic.count() == 0)

    if has_speech and mic.count() == 1:
        mic.click()
        page.wait_for_timeout(1500)  # recog.onerror fires asynchronously once permission is denied
        check("B3 mic click with permission denied: message shown, not accepted silently",
              "microphone access is allowed" in body(),
              "no notice appeared after the denied start")
        page.type("textarea", "still responsive")
        check("B3 composer still usable after the denied mic click", page.input_value("textarea") == "still responsive")
        # The textarea must stay editable after recovering from the denied-mic state.
        check("B4 textarea remains editable after the denied-mic message", page.locator("textarea").is_editable())
    elif has_speech:
        check("B3 mic click with permission denied: skipped, button never appeared", False)
    else:
        check("B3 mic denied path: skipped because Web Speech is absent in this browser", True)

    # A2 — "who are you" describes the assistant; no risk card.
    before = page.locator("main ol > li").count()
    page.fill("textarea", "who are you")
    page.click("button[type=submit]")
    page.wait_for_function(
        f"() => document.querySelectorAll('main ol > li').length >= {before + 2} && !document.querySelector('main li[role=status]')",
        timeout=timeout,
    )
    reply = page.locator("main ol > li").last.inner_text()
    page.screenshot(path=str(SHOTS / "manual_qa_who_are_you.png"), full_page=True)
    check("A2 'who are you': a reply arrives with no risk card",
          page.locator("main section[aria-label='Risk assessment']").count() == 0 and len(reply.strip()) > 10,
          "risk card rendered or the reply was empty")
    check("A2 'who are you' mentions TrustShield", "TrustShield" in reply, reply[:120])

    # D1 — every width from the checklist keeps the page free of horizontal scroll.
    page.set_viewport_size({"width": 390, "height": 800})
    check("D1 390px: no horizontal scroll", no_hscroll(page))
    page.screenshot(path=str(SHOTS / "manual_qa_390.png"), full_page=True)
    for w in (360, 430, 820):
        page.set_viewport_size({"width": w, "height": 800})
        check(f"D1 {w}px: no horizontal scroll", no_hscroll(page))
        page.screenshot(path=str(SHOTS / f"manual_qa_{w}.png"), full_page=True)
    page.set_viewport_size({"width": 1280, "height": 900})

    if not api_up:
        check("A2 backend reachable for real analysis (informational: skipped), see preflight", True)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--web", default="http://127.0.0.1:3000")
    ap.add_argument("--api", default="http://127.0.0.1:8000")
    ap.add_argument("--web-timeout", type=int, default=60_000)
    args = ap.parse_args()
    load_timeout = args.web_timeout

    SHOTS.mkdir(parents=True, exist_ok=True)
    state = {"web": stack_up(args.web), "api": stack_up(f"{args.api}/api/v1/health")}
    print("preflight — web: %s" % json.dumps({"url": args.web, "up": state["web"]}))
    print("preflight — api: %s" % json.dumps({"url": args.api, "up": state["api"]}))
    if not (state["web"] and state["api"]):
        parts = []
        if not state["web"]:
            parts.append(f"frontend http://127.0.0.1:3000 reported down (tried {args.web})")
        if not state["api"]:
            parts.append(f"backend http://127.0.0.1:8000 reported down (tried {args.api})")
        print("")
        print("MISSING STACK: not running on 127.0.0.1:3000 and 8000", "|", "; ".join(parts))
        print("Not starting the production stack.")
        print("Start it, then re-run: uvicorn services.api.main:app --host 127.0.0.1 --port 8000  and  npx next start -p 3000")
        print("0/0 passed — no checks ran because the stack is down.")
        return 2

    exceptions: list[str] = []
    with sync_playwright() as pw:
        browser = pw.chromium.launch()
        context = browser.new_context(viewport={"width": 1280, "height": 900})
        page = context.new_page()
        errors: list[str] = []
        page.on("pageerror", lambda e: errors.append(str(e)))
        page.on("console", lambda m: errors.append(m.text) if m.type == "error" else None)
        page.goto(args.web, wait_until="domcontentloaded", timeout=load_timeout)
        ctx_errors: list[str] = []
        try:
            run(page, state["api"], 60_000)
        except Exception as e:  # a crashed check must still show up as a hard failure
            ctx_errors.append(f"{type(e).__name__}: {e}")
            page.screenshot(path=str(SHOTS / "manual_qa_failure.png"), full_page=True)
        browser.close()
    check("no uncaught page errors during the run", not ctx_errors, "; ".join(ctx_errors)[:300])

    failed = [n for n, ok in results if not ok]
    print(f"\n{len(results) - len(failed)}/{len(results)} passed")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
