 525: async def _chat_turn(request: Request, response: Response, message: str, context: ChatAnalysis | None, signature: str, history: list[Turn],
 526:                      image: tuple[bytes, str | None, str | None] | None) -> ChatOut:
 527:     if sum(len(t.text) for t in history) > 12_000:
 528:         raise HTTPException(422, "conversation context is too large; start a new chat")
 529:     if context is not None and not verify(context, signature):
 530:         context = None  # unsigned or altered context is never trusted
 531:     provider = get_provider()
 532:     intent_result = classify_intent(message, image is not None, context is not None, followup_intent)
 533:     if intent_result.intent == "empty":
 534:         raise HTTPException(422, "Send a message, link, screenshot or QR code to analyse.")
 535: 
 536:     if intent_result.intent in _CHAT_ONLY_REPLY and agent.configured():
 537:         # The model is the chat assistant and may call the scanner. Any failed check falls through to the deterministic path.
 538:         outcome = await _agent_chat(request, response, message, history, intent_result)
 539:         if outcome is not None:
 540:             return outcome
 541: 
 542:     if intent_result.intent in _CHAT_ONLY_REPLY:
 543:         response_type, method_name = _CHAT_ONLY_REPLY[intent_result.intent]
 544:         method = getattr(provider, method_name)
 545:         # Every chat-only handler takes the recent turns, so follow-ups and general questions see the conversation.
 546:         trimmed = [{"role": t.role, "text": t.text[:1500]} for t in history[-6:]]
 547:         reply = await run_in_threadpool(method, message, trimmed)
 548:         return ChatOut(kind="chat", response_type=response_type, intent=intent_result.public(), reply=_reply_out(reply))
 549: 
 550:     if intent_result.intent == "follow_up_analysis":
 551:         assert context is not None and intent_result.followup_intent is not None
 552:         reply = await run_in_threadpool(provider.reply_for_followup, intent_result.followup_intent, message, context)
 553:         return ChatOut(kind="followup", response_type="follow_up", intent=intent_result.public(), reply=_reply_out(reply))
 554: 
 555:     plan = route(message, image is not None, False, followup_intent)  # follow-up already ruled out above; this call only
 556:     # selects which pipeline modules to run (url/text/image) for a message intent classification has already decided to analyse
 557:     try:
 558:         if image is not None:
 559:             result, types = await run_heavy(request, analyze_turn, message, image, plan)
 560:         else:
 561:             result, types = await run_in_threadpool(analyze_turn, message, None, plan)
 562:     except ImageRejected as exc:
 563:         raise _image_error(exc)
 564:     except InvalidInput as exc:
 565:         raise HTTPException(422, str(exc))
 566:     analysis = to_contract(result, types, plan.urls)
 567:     if image is None and intent_result.intent == "analyze_text" and agent.configured():
 568:         # The model reads through spelling mistakes. The scanner checks the corrected text too; the higher risk wins.
 569:         corrected = await run_in_threadpool(agent.correct_spelling, message)
 570:         if corrected:
 571:             plan2 = route(corrected, False, False, followup_intent)
 572:             try:
 573:                 result2, types2 = await run_in_threadpool(analyze_turn, corrected, None, plan2)
 574:             except (InvalidInput, ImageRejected):
 575:                 result2 = None
 576:             if result2 is not None:
 577:                 analysis2 = to_contract(result2, types2, plan2.urls)
 578:                 if analysis2.risk_score > analysis.risk_score:
 579:                     result, plan, analysis = result2, plan2, analysis2
 580:     _publish(request, response, result)
 581:     if agent.configured() and message.strip() and analysis.risk_level != "unable_to_verify":
 582:         text = await run_in_threadpool(agent.explain, message, analysis.model_dump_json(), analysis.risk_score)
 583:         if text:
 584:             return ChatOut(kind="analysis", response_type="analysis", intent=intent_result.public(), route=plan.public(),
 585:                            reply=ReplyOut(text=text, provider="nilabh", grounded=True), analysis=analysis,
 586:                            context_signature=sign(analysis))
 587:     reply = await run_in_threadpool(provider.reply_for_analysis, analysis)
 588:     return ChatOut(kind="analysis", response_type="analysis", intent=intent_result.public(), route=plan.public(),
 589:                    reply=_reply_out(reply), analysis=analysis, context_signature=sign(analysis))
