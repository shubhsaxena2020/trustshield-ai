 194: async def _upload_endpoint(request: Request, response: Response, file: UploadFile, func,
 195:                             user: CurrentUser | None, label: str) -> AnalysisResult:
 196:     try:
 197:         data = await file.read(max_upload_size() + 1)  # the extra byte detects oversize input without unbounded reads
 198:         result = _publish(request, response, await run_heavy(request, func, data, file.content_type, file.filename))
 199:         _record_history(request, user, result, f"{label} ({result.risk.label})")
 200:         return result
 201:     except ImageRejected as exc:
 202:         raise _image_error(exc)
 203:     except InvalidInput as exc:
 204:         raise HTTPException(422, str(exc))
 205:     finally:
 206:         await file.close()
