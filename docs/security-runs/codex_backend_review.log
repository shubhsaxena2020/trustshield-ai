 520: async def chat_stream_endpoint(body: ChatIn):
 521:     return StreamingResponse(_stream_chat_events(body.message, body.history, body.context, body.context_signature),
 522:                              media_type="text/event-stream", headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"})
