 302: 
 303: # Intents handled without ever touching the analysis pipeline: this is the fix for the "yo" -> "Low Risk 0/100" bug. Analysis
 304: # always wins when there is a URL, an attachment, or unmatched content (see services/chat/intent.py's priority order).
 305: _CHAT_ONLY_REPLY = {
 306:     "greeting": ("chat", "reply_greeting"), "assistant_qa": ("chat", "reply_greeting"), "off_topic": ("chat", "reply_off_topic"),
 307:     "general_cyber_qa": ("education", "reply_cyber_qa"), "product_qa": ("product_info", "reply_product_qa"),
 308:     "general_chat": ("chat", "reply_chat"),
 309: }
 310: 
 311: 
 312: 
 313: def _refine_with_model(intent_result, message: str, has_image: bool):
 314:     """Model decides only the uncertain cases: plain text with soft risk words and no strong scam signal. Strong signals,
 315:     links and attachments keep the rule decision. The model may move a question or task to chat, never a pasted message."""
 316:     from services.chat.intent import has_suspicious_signal, has_transaction_signal, is_question_or_task
 317:     if (intent_result.intent != "analyze_text" or has_image or intent_result.urls or has_suspicious_signal(message)
 318:             or not agent.configured() or not is_question_or_task(message) or has_transaction_signal(message)):
 319:         return intent_result
 320:     verdict = agent.route_text(message)
 321:     if verdict == "chat":
 322:         from services.chat.intent import IntentResult
 323:         return IntentResult("general_chat", "model routing: a question or task, not content to check")
 324:     return intent_result
 325: 
 326: async def _agent_chat(request: Request, response: Response, message: str, history: list[Turn], intent_result) -> ChatOut | None:
 327:     """Model-led chat turn. Returns None when the model is unavailable or a reply fails a check."""
 328:     captured: dict = {}
 329: 
 330:     def scan(text: str) -> str:
 331:         plan = route(text, False, False, followup_intent)
 332:         try:
 333:             result, types = analyze_turn(text, None, plan)
 334:         except (InvalidInput, ImageRejected) as exc:
 335:             return json.dumps({"error": str(exc)[:200]})
 336:         analysis = to_contract(result, types, plan.urls)
 337:         captured.update(result=result, plan=plan, analysis=analysis)
 338:         return json.dumps(analysis.model_dump(mode="json"), default=str)[:6000]
 339: 
 340:     recent = [{"role": t.role, "text": t.text[:1500]} for t in history[-8:]]
 341:     agent_reply = await run_in_threadpool(agent.run, message, recent, scan)
 342:     if agent_reply is None:
 343:         return None
 344:     analysis = captured.get("analysis")
 345:     if not agent.reply_is_acceptable(agent_reply.text, analysis.risk_score if analysis is not None else None):
 346:         return None
 347:     if analysis is not None:
 348:         _publish(request, response, captured["result"])
 349:         return ChatOut(kind="analysis", response_type="analysis", intent=intent_result.public(), route=captured["plan"].public(),
 350:                        reply=ReplyOut(text=agent_reply.text, provider="nilabh", grounded=True), analysis=analysis,
 351:                        context_signature=sign(analysis))
 352:     response_type = _CHAT_ONLY_REPLY[intent_result.intent][0]
 353:     return ChatOut(kind="chat", response_type=response_type, intent=intent_result.public(),
 354:                    reply=ReplyOut(text=agent_reply.text, provider="nilabh", grounded=True))
 355: 
 356: 
 357: def _sse(event: dict) -> str:
 358:     return "data: " + json.dumps(event, default=str) + "\n\n"
 359: 
 360: 
 361: def _text_events(text: str):
 362:     """Deterministic text is sent as word-sized tokens so the client paints it the same way as a streamed model answer."""
 363:     for piece in re.findall(r"\S+\s*|\s+", text):
 364:         yield _sse({"type": "token", "text": piece})
 365: 
 366: 
 367: _UNAVAILABLE_TEXT = ("The language model isn't responding right now, so I can't answer that yet. "
 368:                      "Please send your message again in a moment.")
 369: _REJECTED_TEXT = "I couldn't give a reliable answer to that one. Could you ask it another way?"
 370: 
 371: 
 372: _CONVERSATIONAL_REFERENCE = re.compile(
 373:     r"\b(this|that|it)\s+(is\s+|was\s+)?(a\s+|an\s+|about\s+|the\s+|related\s+|same\s+|another\s+)*"
 374:     r"(question|topic|thing|one|subject|answer|reply|point|query)\b", re.I)
 375: 
 376: 
 377: def _may_scan(message: str) -> bool:
 378:     """The scanner is for content the user shares: a link, a fraud or payment signal, or a passage of text. A question, a
 379:     request, or a remark about an earlier reply ("but this is a related question") is never scanned."""
 380:     if extract_urls(message):
 381:         return True
 382:     words = len(message.split())
 383:     if has_suspicious_signal(message) or has_action_or_object_risk(message):
 384:         return not is_question_or_task(message) or words >= 12
 385:     if is_question_or_task(message) or _CONVERSATIONAL_REFERENCE.search(message):
 386:         return False
 387:     return words >= 4
 388: 
 389: 
 390: def _make_scan(message: str, captured: dict):
 391:     """The tool the model can call. It refuses anything that is not content the user shared, and records the analysis."""
 392:     def scan(text: str) -> str:
 393:         if not _may_scan(message):
 394:             return json.dumps({"error": "the user asked a question or replied; answer it directly, do not scan"})
 395:         plan = route(text, False, False, followup_intent)
 396:         try:
 397:             result, types = analyze_turn(text, None, plan)
 398:         except (InvalidInput, ImageRejected) as exc:
 399:             return json.dumps({"error": str(exc)[:200]})
 400:         analysis = to_contract(result, types, plan.urls)
 401:         captured.update(result=result, plan=plan, analysis=analysis)
 402:         return json.dumps(analysis.model_dump(mode="json"), default=str)[:6000]
 403:     return scan
 404: 
 405: 
 406: def _analysis_event(captured: dict) -> str:
 407:     a = captured["analysis"]
 408:     return _sse({"type": "analysis", "analysis": a.model_dump(mode="json"), "signature": sign(a),
 409:                  "route": captured["plan"].public(), "response_type": "analysis"})
 410: 
 411: 
 412: def _explain_analysis_events(message: str, analysis):
 413:     """The model explains a scanner result (it cannot change it). If the explanation fails a check, the template explanation is shown."""
 414:     final_text = ""
 415:     if agent.configured():
 416:         try:
 417:             for kind, payload in agent.stream_explain(message, analysis.model_dump_json()):
 418:                 if kind == "token":
 419:                     yield _sse({"type": "token", "text": payload})
 420:                 elif kind == "final":
 421:                     final_text = payload
 422:         except Exception:  # model unavailable: the template explanation below is used
 423:             final_text = ""
 424:     if not (final_text and agent.reply_is_acceptable(final_text, analysis.risk_score, explanation=True)):
 425:         yield _sse({"type": "replace", "text": DeterministicExplanationProvider().reply_for_analysis(analysis).text})
 426: 
 427: 
 428: def _model_events(message: str, recent: list[dict], captured: dict, scan):
 429:     """Every message goes to the model first. The model answers, and calls the scanner only when agent.stream_turn decides the
 430:     user shared content. A failure before any text is shown is retried once. If the model is still down, shared content is
 431:     still scanned directly, so a real scam is never left unchecked."""
 432:     if not agent.configured():
 433:         yield _sse({"type": "replace", "text": _UNAVAILABLE_TEXT})
 434:         return
 435:     final_text = ""
 436:     for attempt in range(3):
 437:         shown = False
 438:         final_text = ""
 439:         ok = False
 440:         if attempt:
 441:             time.sleep(1.5 * attempt)  # the model host sheds load with 503s; a short pause usually clears it
 442:         try:
 443:             for kind, payload in agent.stream_turn(message, recent, scan):
 444:                 if kind == "token":
 445:                     shown = True
 446:                     yield _sse({"type": "token", "text": payload})
 447:                 elif kind == "reset":
 448:                     shown = False
 449:                     yield _sse({"type": "reset"})
 450:                 elif kind == "scanned" and captured.get("analysis") is not None:
 451:                     yield _analysis_event(captured)
 452:                 elif kind == "final":
 453:                     final_text = payload
 454:             # An empty reply (a failed call) is never accepted, so the loop retries it.
 455:             ok = captured.get("analysis") is not None or (bool(final_text) and agent.reply_is_acceptable(final_text, None, explanation=True))
 456:         except Exception:  # network, timeout or malformed response from the model
 457:             final_text = ""
 458:         if ok or captured.get("analysis") is not None:
 459:             break
 460:         # A reply that failed the check (or a failed connection) is retried once, with the earlier text cleared first.
 461:         if attempt < 2 and (shown or final_text):
 462:             yield _sse({"type": "reset"})
 463:     analysis = captured.get("analysis")
 464:     if analysis is not None:
 465:         if not (final_text and agent.reply_is_acceptable(final_text, analysis.risk_score, explanation=True)):
 466:             yield _sse({"type": "replace", "text": DeterministicExplanationProvider().reply_for_analysis(analysis).text})
 467:     elif final_text:
 468:         if not agent.reply_is_acceptable(final_text, None, explanation=True):
 469:             yield _sse({"type": "replace", "text": _REJECTED_TEXT})
 470:     elif _may_scan(message) and (has_suspicious_signal(message) or has_action_or_object_risk(message) or extract_urls(message)):
 471:         scan(message)  # the model is down: a message with scam signals is still analysed directly
 472:         if captured.get("analysis") is not None:
 473:             yield _analysis_event(captured)
 474:             yield _sse({"type": "replace", "text": DeterministicExplanationProvider().reply_for_analysis(captured["analysis"]).text})
 475:         else:
 476:             yield _sse({"type": "replace", "text": _UNAVAILABLE_TEXT})
 477:     else:
 478:         yield _sse({"type": "replace", "text": _UNAVAILABLE_TEXT})
 479: 
 480: 
 481: def _stream_chat_events(message: str, history: list[Turn], context: ChatAnalysis | None, signature: str):
 482:     try:
 483:         if sum(len(t.text) for t in history) > 12_000:
 484:             yield _sse({"type": "error", "detail": "conversation context is too large; start a new chat"})
 485:             return
 486:         if context is not None and not verify(context, signature):
 487:             context = None
 488:         provider = get_provider()
 489:         recent = [{"role": t.role, "text": t.text[:1500]} for t in history[-8:]]
 490:         intent_result = classify_intent(message, False, context is not None, followup_intent)
 491:         if intent_result.intent == "empty":
 492:             yield _sse({"type": "error", "detail": "Send a message, link, screenshot or QR code to analyse."})
 493:             return
 494:         meta = intent_result.public()
 495: 
 496:         # Every message goes to the model first; it decides whether to call the scanner (see _model_events and _may_scan).
 497:         response_type = _CHAT_ONLY_REPLY.get(intent_result.intent, ("chat", ""))[0]
 498:         yield _sse({"type": "meta", "kind": "chat", "response_type": response_type, "intent": meta})
 499:         captured: dict = {}
 500:         scan = _make_scan(message, captured)
 501:         # Content that carries a link or a scam signal is always scanned first (2026-10-07): the model must not be able to skip a link.
 502:         # The model then explains the result; the score is the scanner's.
 503:         if _may_scan(message) and (extract_urls(message) or has_suspicious_signal(message) or has_action_or_object_risk(message)):
 504:             scan(message)
 505:             if captured.get("analysis") is not None:
 506:                 yield _analysis_event(captured)
 507:                 yield from _explain_analysis_events(message, captured["analysis"])
 508:                 yield _sse({"type": "done"})
 509:                 return
 510:         yield from _model_events(message, recent, captured, scan)
 511:         yield _sse({"type": "done"})
 512:     except (InvalidInput, ImageRejected) as exc:
 513:         yield _sse({"type": "error", "detail": str(exc)[:300]})
 514:     except Exception:
 515:         _log.exception("chat stream failed")
 516:         yield _sse({"type": "error", "detail": "Something went wrong. Please try again."})
