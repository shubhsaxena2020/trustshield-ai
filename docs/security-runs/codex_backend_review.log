  59: # ---- per-request helpers -------------------------------------------------------------------------------------------
  60: 
  61: def _state(request: Request):
  62:     return request.app.state
  63: 
  64: 
  65: def _client(request: Request) -> str:
  66:     hops = _state(request).settings.trusted_proxy_hops
  67:     return client_key((request.client.host, request.client.port) if request.client else None,
  68:                       request.headers.get("x-forwarded-for"), hops)
  69: 
  70: 
  71: def _limit(limiter_name: str):
  72:     def dependency(request: Request) -> None:
  73:         allowed, retry = getattr(_state(request), limiter_name).allow(_client(request))
  74:         if not allowed:
  75:             raise HTTPException(429, "Too many requests; please slow down and retry shortly",
  76:                                 headers={"Retry-After": str(max(1, math.ceil(retry)))})
  77:     return dependency
  78: 
  79: 
  80: limit_light = _limit("limit_light")
  81: limit_heavy = _limit("limit_heavy")
  82: 
  83: 
  84: def _publish(request: Request, response: Response, result: AnalysisResult, *, retain: bool = False) -> AnalysisResult:
  85:     """Attach the analysis id, log module problems (never content), and store only if policy requires it."""
  86:     response.headers["X-Analysis-ID"] = result.analysis_id
  87:     request_id = getattr(request.state, "request_id", None)
  88:     for name, module in result.modules.items():
  89:         status = module.status
  90:         if status in {"failed", "timeout"} or (name in {"ml", "ocr", "qr"} and status == "unavailable"):
  91:             event = "ml_unavailable" if name == "ml" else "ocr_failure" if name == "ocr" else "module_failure"
  92:             event_log.warning(json.dumps({"event": event, "request_id": request_id, "analysis_id": result.analysis_id,
  93:                                           "module": name, "status": status}))
  94:     _state(request).store.put(result, retain=retain)
  95:     return result
  96: 
  97: 
  98: def _record_history(request: Request, user: CurrentUser | None, result: AnalysisResult, raw_text: str) -> None:
  99:     if user is None:
 100:         return
 101:     settings = _state(request).settings
 102:     if not settings.supabase_url or not settings.supabase_service_role_key:
 103:         return
 104:     history_store.save(
 105:         settings.supabase_url, settings.supabase_service_role_key,
 106:         user_id=user.id, input_type=result.input_type,
 107:         input_summary=history_store.summarize(raw_text),
 108:         risk_score=result.risk.score, risk_label=result.risk.label,
 109:         result_json=result.model_dump(mode="json"),
 110:     )
 111: 
 112: 
 113: async def run_heavy(request: Request, func, *args):
 114:     """CPU-heavy work (OCR/QR): bounded concurrency, queue timeout, overall timeout, off the event loop."""
 115:     state = _state(request)
 116:     try:
 117:         await asyncio.wait_for(state.heavy_gate.acquire(), state.settings.heavy_queue_timeout_s)
 118:     except asyncio.TimeoutError:
 119:         raise HTTPException(503, "The server is busy analysing other uploads; please retry shortly", headers={"Retry-After": "5"})
 120:     try:
 121:         return await asyncio.wait_for(run_in_threadpool(func, *args), state.settings.request_timeout_s)
 122:     except asyncio.TimeoutError:
 123:         raise HTTPException(504, "The analysis took too long and was stopped")
 124:     finally:
 125:         state.heavy_gate.release()
